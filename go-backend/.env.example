# Database Configuration
# Using SQLite
DB_NAME=memorycard.db

# Authentication
# Secret key for signing JWT tokens. Change this to a secure random string in production.
JWT_SECRET=your_secret_key_here

# Payment Gateway (Asaas)
# Obtain from Asaas Dashboard -> Configurações de Conta -> Integração
ASAAS_API_KEY=your_asaas_api_key_here

# Optional: Secret token for validating Asaas Webhooks
ASAAS_WEBHOOK_AccessToken=your_webhook_secret_here
# Asaas API base. Empty = sandbox (https://sandbox.asaas.com/api/v3). Production: https://api.asaas.com/v3
ASAAS_API_URL=
# "Sem anúncios para sempre" (one-time purchase, removes ads from the app). Default 10.00 (BRL)
AD_FREE_PRICE=10.00

# Server Configuration
PORT=8000

# ---------------------------------------------------------------
# Catálogo público (recomps, ports e emuladores) — internal/catalog
# ---------------------------------------------------------------
# URL pública desta API (gera links absolutos de mirror e imagens)
PUBLIC_BASE_URL=https://memorycard.cloud
# Opcional: token do GitHub (5000 req/h em vez de 60). Com ETag quase tudo vira 304 grátis.
GITHUB_TOKEN=
# Opcional: capas/logos de jogos em alta qualidade (https://www.steamgriddb.com/profile/preferences/api)
STEAMGRIDDB_API_KEY=
# Token para POST /api/catalog/refresh (header X-Admin-Token)
CATALOG_ADMIN_TOKEN=
# Espelhar binários no servidor (true/false), quais plataformas e tamanho máximo por arquivo
CATALOG_MIRROR=true
CATALOG_MIRROR_PLATFORMS=windows,linux,macos,android,ios
CATALOG_MIRROR_MAX_MB=1024
# Teto do espelho inteiro em MB (0 = sem teto). Versões atuais mais baixadas primeiro; o resto redireciona ao link oficial.
CATALOG_MIRROR_TOTAL_MB=30720
# Intervalos: checa fontes vencidas a cada CATALOG_TICK; fontes sem mudança vão de MIN até MAX
CATALOG_TICK=15m
CATALOG_MIN_INTERVAL=6h
CATALOG_MAX_INTERVAL=48h
CATALOG_IMAGE_INTERVAL=720h
# Robôs de build (scripts/catalog, Node) no painel do superadmin (/admin, aba de robôs).
# O relatório deles vai embutido no binário (internal/catalog/build-report.json); este arquivo, se mais novo, ganha.
CATALOG_BUILD_REPORT=
# Pasta do repositório para o painel poder RODAR os scripts (vazio = desligado; precisa de node no servidor)
CATALOG_BUILD_ROOT=
CATALOG_NODE=
# Servir a landing page (build de /landing) por esta API
LANDING_DIR=
# Pasta com os instaladores do próprio app (servida em /downloads/app)
APP_RELEASES_DIR=./data/app-releases
# Jogos nativos (abandonware) enviados pelo /admin (padrão: $DATA_DIR/native-games)
NATIVE_GAMES_DIR=
# Origens extras permitidas (CORS), separadas por vírgula
CORS_ORIGINS=

# ---------------------------------------------------------------
# Biblioteca privada de ROMs (superadmin + contas liberadas por ele)
# ---------------------------------------------------------------
# Google Cloud Console → APIs e serviços → Credenciais → ID do cliente OAuth (Aplicativo da Web).
# Ative a "Google Drive API" no projeto. URI de redirecionamento autorizado:
#   <PUBLIC_BASE_URL>/api/gdrive/oauth/callback   (ou o valor de GOOGLE_REDIRECT_URL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
# Para onde voltar depois do login Google (página /admin/ do site)
SITE_URL=https://memorycard.cloud
# Cópia local no SSD (padrão: $DATA_DIR/roms-cache). Pasta nova ou vazia: o servidor gerencia tudo nela.
ROMS_CACHE_DIR=
# Limite de espaço da cópia local em GB (vazio = sem limite). Acima disso o arquivo é servido direto do Drive.
ROMS_CACHE_MAX_GB=
# Reler a pasta do Drive a cada N horas (também dá para sincronizar na hora pelo /admin/)
ROMS_SYNC_HOURS=6
