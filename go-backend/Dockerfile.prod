# Build Stage
FROM golang:1.24-alpine AS builder

WORKDIR /app

# Install git for fetch
RUN apk add --no-cache git

# Copy go mod and sum
# Copy source first to allow tidy
COPY . .
RUN go mod tidy

# Build the application
# -ldflags="-w -s" reduces binary size by stripping debug info
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o main .

# Final Stage
FROM alpine:latest

WORKDIR /app

# Install dependencies if needed (e.g. ca-certificates for HTTPS)
RUN apk add --no-cache ca-certificates tzdata

# Copy binary from builder
COPY --from=builder /app/main .

# Copy uploads directory creation (if needed) or rely on volume
RUN mkdir -p /app/uploads && mkdir -p /app/data

# Expose port
EXPOSE 8000

# Run the binary
CMD ["./main"]
