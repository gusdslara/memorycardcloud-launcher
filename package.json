{
  "name": "memorycardcloud-launcher",
  "version": "0.1.4",
  "description": "MemoryCard.cloud - Game Save Manager & Recomps/Decomps Hub",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "node --experimental-strip-types --test tests/**/*.test.ts",
    "tauri": "tauri",
    "verify:catalog": "node --experimental-strip-types scripts/verify-catalog.ts",
    "export:catalog": "node --experimental-strip-types scripts/export-catalog.ts",
    "art:fetch": "node --experimental-strip-types scripts/fetch-art.ts",
    "art:build": "node --experimental-strip-types scripts/catalog/build-art.mjs",
    "meta:build": "node --experimental-strip-types scripts/catalog/build-meta.mjs",
    "media:build": "npm run art:build && npm run meta:build && npm run art:build",
    "catalog:build": "node --experimental-strip-types scripts/catalog/build-ports.mjs",
    "catalog:build:offline": "node --experimental-strip-types scripts/catalog/build-ports.mjs --offline",
    "landing:dev": "npm --prefix landing run dev",
    "landing:build": "npm run export:catalog && npm --prefix landing run build",
    "release:app": "node scripts/release-app.mjs",
    "publish:app": "node scripts/publish-app-release.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "lucide-svelte": "^0.475.0",
    "svelte-i18n": "^4.0.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "yaml": "^2.8.2"
  }
}
