{
  "name": "memorycard-landing",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Site público do MemoryCard.cloud: baixar o app e o catálogo de ports, recomps e emuladores (mesmas listas do app).",
  "scripts": {
    "dev": "vite dev --port 5174",
    "build": "node scripts/build.mjs",
