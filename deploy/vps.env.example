# .env de PRODUÇÃO da VPS. Copie para deploy/vps.env (fica fora do git) e preencha.
# O vps-deployer envia este arquivo como .env do projeto a cada deploy (chmod 600 na VPS).

# ---------------------------------------------------------------- obrigatórios
# Segredo dos tokens de login (gere com: openssl rand -hex 32)
JWT_SECRET=
# Conta superadmin (criada no 1º start). O builder usa a mesma conta para publicar as builds do app.
# Evite o caractere $ nos valores (o docker compose tenta interpretá-lo).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------- endereços
PUBLIC_BASE_URL=https://memorycard.cloud
SITE_URL=https://memorycard.cloud
# Origens extras para CORS (separadas por vírgula). Vazio = padrão do código (site + app Tauri)
CORS_ORIGINS=

# ---------------------------------------------------------------- pastas na VPS (fora do projeto)
# Banco, saves, builds do app, jogos nativos e mirror do catálogo
MEMORYCARD_HOME=/opt/memorycard
DB_NAME=memorycard.db
# Cópia da biblioteca de ROMs no SSD
ROMS_SSD_PATH=/opt/memorycard/roms-cache
ROMS_CACHE_MAX_GB=
ROMS_SYNC_HOURS=6

# ---------------------------------------------------------------- builds do app (a cada deploy)
# Plataformas compiladas na VPS. macos e ios precisam de um Mac (scripts/release-app.mjs lá).
APP_PLATFORMS=linux,windows,android
# ABIs do APK universal
ANDROID_TARGETS=aarch64 armv7 x86_64
# Novidades exibidas no app e em /baixar (opcional)
APP_RELEASE_NOTES=
# 1 = recompila mesmo sem mudanças no código do app
FORCE_APP_BUILD=
# Senha da chave do atualizador, se ela tiver uma
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# ---------------------------------------------------------------- pagamentos (Asaas)
ASAAS_API_KEY=
ASAAS_WEBHOOK_AccessToken=

# ---------------------------------------------------------------- catálogo (scraper, mirror, imagens)
GITHUB_TOKEN=
STEAMGRIDDB_API_KEY=
CATALOG_ADMIN_TOKEN=
CATALOG_MIRROR=true
CATALOG_MIRROR_PLATFORMS=windows,linux,macos,android,ios
CATALOG_MIRROR_MAX_MB=1024
# Teto do espelho inteiro em MB (0 = sem teto). Versões atuais mais baixadas primeiro; o resto redireciona ao link oficial.
CATALOG_MIRROR_TOTAL_MB=30720
CATALOG_TICK=15m
CATALOG_MIN_INTERVAL=6h
CATALOG_MAX_INTERVAL=48h
CATALOG_IMAGE_INTERVAL=720h

# ---------------------------------------------------------------- Google Drive (biblioteca privada)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://memorycard.cloud/api/gdrive/oauth/callback
