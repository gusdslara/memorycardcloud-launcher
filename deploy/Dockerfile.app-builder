# Ambiente que compila o app MemoryCard (Tauri 2) na VPS:
#   Linux    AppImage (+ .deb)            nativo
#   Windows  instalador NSIS (.exe)       cross-compile com cargo-xwin (MSVC) + makensis
#   Android  APK universal assinado       Android SDK + NDK
# macOS e iOS só compilam num Mac (exigência da Apple): o mesmo scripts/release-app.mjs
# roda lá com --platforms macos,ios.
#
# Ubuntu 22.04 de propósito: o AppImage gerado aqui roda em distros mais antigas (glibc 2.35).
FROM ubuntu:22.04

ARG NODE_MAJOR=22
ARG ANDROID_CMDLINE_TOOLS=11076708
ARG ANDROID_PLATFORM=android-36
ARG ANDROID_BUILD_TOOLS=35.0.0
ARG ANDROID_NDK=27.2.12479018

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    RUSTUP_HOME=/opt/rustup \
    CARGO_INSTALL_ROOT=/opt/cargo \
    ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    NDK_HOME=/opt/android-sdk/ndk/27.2.12479018 \
    JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 \
    PATH=/opt/cargo/bin:/opt/node/bin:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:$PATH

# Dependências de build do Tauri (Linux), do cross-compile para Windows e do Android
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl wget git file xz-utils unzip zip jq xdg-utils \
      build-essential pkg-config libssl-dev patchelf squashfs-tools desktop-file-utils \
      libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev librsvg2-dev libxdo-dev \
      nsis lld llvm clang \
      openjdk-17-jdk-headless \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /usr/share/nsis/Include/Win \
    && curl -fsSL "https://raw.githubusercontent.com/kichik/nsis/master/Include/Win/RestartManager.nsh" -o /usr/share/nsis/Include/Win/RestartManager.nsh \
    # nomes sem versão das ferramentas LLVM que o cross-compile para Windows procura
    && for t in llvm-rc llvm-lib llvm-ar llvm-dlltool lld-link clang-cl; do \
         command -v "$t" >/dev/null || ln -sf "$(ls -d /usr/lib/llvm-*/bin/$t | sort -V | tail -1)" "/usr/local/bin/$t"; \
       done \
    && llvm-rc /? >/dev/null 2>&1 || command -v llvm-rc

# Node.js (última da linha NODE_MAJOR)
RUN set -eux; \
    base="https://nodejs.org/dist/latest-v${NODE_MAJOR}.x"; \
    file="$(curl -fsSL "$base/SHASUMS256.txt" | awk '/linux-x64.tar.xz$/ {print $2}')"; \
    curl -fsSL "$base/$file" -o /tmp/node.tar.xz; \
    curl -fsSL "$base/SHASUMS256.txt" | grep " $file\$" | sed "s#$file#/tmp/node.tar.xz#" | sha256sum -c -; \
    mkdir -p /opt/node && tar -xJf /tmp/node.tar.xz -C /opt/node --strip-components=1 && rm /tmp/node.tar.xz; \
    node --version

# Rust + alvos Windows (MSVC) e Android; cargo-xwin baixa o SDK do Windows na 1ª build
RUN set -eux; \
    curl -fsSL https://sh.rustup.rs | CARGO_HOME=/opt/cargo sh -s -- -y --profile minimal --default-toolchain stable --no-modify-path; \
    CARGO_HOME=/opt/cargo rustup target add \
      x86_64-pc-windows-msvc \
      aarch64-linux-android armv7-linux-androideabi i686-linux-android x86_64-linux-android; \
    CARGO_HOME=/opt/cargo cargo install --locked cargo-xwin; \
    rm -rf /opt/cargo/registry /opt/cargo/git; \
    chmod -R a+rwX /opt/rustup /opt/cargo

# Android SDK + NDK (licenças aceitas aqui)
RUN set -eux; \
    mkdir -p "$ANDROID_HOME/cmdline-tools"; \
    curl -fsSL "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_CMDLINE_TOOLS}_latest.zip" -o /tmp/clt.zip; \
    unzip -q /tmp/clt.zip -d "$ANDROID_HOME/cmdline-tools" && mv "$ANDROID_HOME/cmdline-tools/cmdline-tools" "$ANDROID_HOME/cmdline-tools/latest"; \
    rm /tmp/clt.zip; \
    yes | sdkmanager --licenses >/dev/null; \
    sdkmanager --install "platform-tools" "platforms;${ANDROID_PLATFORM}" "build-tools;${ANDROID_BUILD_TOOLS}" "ndk;${ANDROID_NDK}" >/dev/null; \
    test -d "$NDK_HOME"; \
    chmod -R a+rwX "$ANDROID_HOME"

# Roda com o UID do dono da pasta na VPS (docker compose `user:`): HOME e caches graváveis por qualquer um.
# Os caches de verdade ficam em /cache (pasta .deploy-cache do projeto), preservados entre deploys.
RUN mkdir -p /home/builder /cache && chmod 1777 /home/builder /cache
ENV HOME=/home/builder \
    CARGO_HOME=/cache/cargo \
    GRADLE_USER_HOME=/cache/gradle \
    XWIN_CACHE_DIR=/cache/xwin \
    XDG_CACHE_HOME=/cache/xdg \
    npm_config_cache=/cache/npm \
    npm_config_update_notifier=false \
    APPIMAGE_EXTRACT_AND_RUN=1 \
    NO_STRIP=true \
    CI=true

WORKDIR /workspace
CMD ["bash", "deploy/build-apps.sh"]
